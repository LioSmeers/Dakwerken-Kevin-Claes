---
const base = import.meta.env.BASE_URL;
const home = Astro.url.pathname === base ? "" : base;
---

<footer class="footer">
  <a class="footer__logo" href={base} aria-label="Kevin Claes Algemene Dakwerken">
    <img
      src={`${base}images/11-logo-kevin-claes.png`}
      alt="Kevin Claes Algemene Dakwerken"
      loading="lazy"
      width="1480"
      height="440"
    />
  </a>

  <nav class="footer__nav" aria-label="Footernavigatie">
    <a href={`${home}#diensten`}>Diensten</a>
    <a href={`${home}#realisaties`}>Realisaties</a>
    <a href={`${home}#over-ons`}>Over ons</a>
    <a href={`${home}#contact`}>Contact</a>
  </nav>

  <p class="footer__name">Algemene Dakwerken Kevin Claes<br /><span class="footer__enterprise">Btw-nummer BE 0767 442 125</span></p>

  <div class="footer__bottom">
    <a href={`${base}privacy/`}>Privacybeleid</a>
    <p>© 2026 Kevin Claes Algemene Dakwerken</p>
    <p>
      Website door{" "}
      <a href="https://bmastudio.be" target="_blank" rel="noopener noreferrer">BMA Studio</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: minmax(9rem, 0.8fr) minmax(16rem, 1fr) minmax(16rem, 0.8fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 3rem) var(--content-gutter);
    color: var(--color-white);
    background: #0e1011;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer__logo {
    display: inline-flex;
    width: clamp(8.5rem, 13vw, 12rem);
  }

  .footer__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem clamp(1rem, 2.4vw, 2rem);
    justify-content: center;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .footer__nav a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer__nav a:hover,
  .footer__nav a:focus-visible {
    color: var(--color-white);
  }

  .footer__name {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: right;
  }

  .footer__bottom {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    justify-content: space-between;
    padding-top: 1.35rem;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__bottom a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration-color: rgba(255, 211, 67, 0.56);
    text-underline-offset: 0.22em;
    transition: color 160ms ease;
  }

  .footer__bottom a:hover,
  .footer__bottom a:focus-visible {
    color: var(--color-accent);
  }

  .footer__enterprise { display: inline-block; margin-top: 0.5rem; font-size: 0.8rem; font-weight: 400; }
  @media (max-width: 860px) {
    .footer { grid-template-columns: 1fr; }
    .footer__nav { justify-content: flex-start; }
    .footer__name { text-align: left; }
  }
  @media (max-width: 560px) {
    .footer__bottom { display: grid; }
  }
</style>
