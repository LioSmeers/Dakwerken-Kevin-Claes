---
const base = import.meta.env.BASE_URL;
---

<section class="about" id="over-ons" aria-labelledby="about-title">
  <div class="about__media" data-about-reveal>
    <img
      src={`${base}images/02-over-bestelwagen-logo.png`}
      alt="Bestelwagen van Kevin Claes Algemene Dakwerken"
      data-about-image
      loading="lazy"
      width="1448"
      height="1086"
    />
  </div>

  <div class="about__content">
    <p class="about__eyebrow" data-about-reveal>OVER ONS</p>
    <h2 id="about-title" data-about-reveal>
      Persoonlijk vakmanschap, van eerste contact tot afwerking.
    </h2>
    <p class="about__text" data-about-reveal>
      Kevin Claes staat voor degelijk dakwerk, duidelijke communicatie en een verzorgde
      afwerking. Van renovatie tot Velux en zinkwerk: elk project wordt uitgevoerd met aandacht
      voor kwaliteit en duurzaamheid.
    </p>

    <ul class="about__list" data-about-reveal>
      <li>Persoonlijke aanpak</li>
      <li>Kwalitatieve materialen</li>
      <li>Nette afwerking</li>
    </ul>

    <a class="about__cta" href="#contact" data-about-reveal>Vraag uw offerte aan</a>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    gsap.from("[data-about-reveal]", {
      autoAlpha: 0,
      y: 24,
      duration: 0.85,
      ease: "power3.out",
      stagger: 0.11,
      immediateRender: false,
      scrollTrigger: {
        trigger: ".about",
        start: "top 72%",
        once: true,
      },
    });

    gsap.to("[data-about-image]", {
      yPercent: -8,
      ease: "none",
      scrollTrigger: {
        trigger: ".about",
        start: "top bottom",
        end: "bottom top",
        scrub: true,
      },
    });
  }
</script>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    min-height: 100vh;
    padding: var(--section-space) var(--content-gutter);
    color: var(--color-white);
    background:
      linear-gradient(180deg, #111314 0%, #171a1b 100%),
      var(--color-charcoal);
  }

  .about__media {
    position: relative;
    height: min(74vh, 48rem);
    min-height: 31rem;
    overflow: hidden;
    background: var(--color-charcoal-soft);
  }

  .about__media::after {
    position: absolute;
    inset: 0;
    content: "";
    background:
      linear-gradient(180deg, rgba(17, 19, 20, 0.04) 0%, rgba(17, 19, 20, 0.36) 100%),
      linear-gradient(90deg, rgba(17, 19, 20, 0.18) 0%, rgba(17, 19, 20, 0) 52%);
    pointer-events: none;
  }

  .about__media img {
    display: block;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: center;
  }

  .about__content {
    max-width: 43rem;
    padding-block: clamp(1rem, 4vw, 3rem);
  }

  .about__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: var(--label-size);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .about h2 {
    margin: 0;
    font-size: clamp(2.55rem, 5.9vw, 5.15rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .about__text {
    max-width: 39rem;
    margin: 1.65rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    line-height: 1.72;
  }

  .about__list {
    display: grid;
    gap: 0;
    max-width: 32rem;
    margin: 2.15rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .about__list li {
    position: relative;
    padding: 1rem 0 1rem 1.55rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.98rem;
    font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .about__list li::before {
    position: absolute;
    top: 1.48rem;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    content: "";
    background: var(--color-accent);
  }

  .about__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.2rem;
    margin-top: 2rem;
    padding: 0 1.35rem;
    color: var(--color-charcoal);
    font-size: 0.94rem;
    font-weight: 800;
    text-decoration: none;
    background: var(--color-accent);
    border: 1px solid rgba(255, 211, 67, 0.64);
    border-radius: 4px;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .about__cta:hover,
  .about__cta:focus-visible {
    background: var(--color-accent-soft);
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .about {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .about__media {
      height: clamp(27rem, 62vw, 40rem);
      min-height: 0;
    }

    .about__content {
      max-width: none;
      padding-block: 0;
    }
  }

  @media (max-width: 560px) {
    .about__media {
      height: 24rem;
    }

    .about__cta {
      width: 100%;
    }
  }
</style>
