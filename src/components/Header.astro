---
const base = import.meta.env.BASE_URL;
const home = Astro.url.pathname === base ? "" : base;
---

<header class="site-header" data-header>
  <a class="site-header__logo" href={base} aria-label="Kevin Claes Algemene Dakwerken">
    <img
      src={`${base}images/11-logo-kevin-claes.png`}
      alt="Kevin Claes Algemene Dakwerken"
      width="1480"
      height="440"
    />
  </a>

  <nav class="site-header__nav" id="site-navigation" data-nav data-lenis-prevent aria-label="Hoofdnavigatie">
    <a href={`${home}#diensten`}>Diensten</a>
    <a href={`${home}#realisaties`}>Realisaties</a>
    <a href={`${home}#over-ons`}>Over ons</a>
    <a href={`${home}#contact`}>Contact</a>
    <a class="site-header__mobile-cta" href={`${home}#contact`}>Gratis offerte</a>
  </nav>

  <a class="site-header__cta" href={`${home}#contact`}>Gratis offerte</a>

  <button
    class="site-header__toggle"
    type="button"
    data-menu-toggle
    aria-controls="site-navigation"
    aria-expanded="false"
    aria-label="Menu openen"
  >
    <span class="site-header__toggle-label">Menu</span>
    <span class="site-header__toggle-icon" aria-hidden="true"></span>
  </button>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileViewport = window.matchMedia("(max-width: 900px)");

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };

  const setMenuState = (open: boolean, restoreFocus = false) => {
    const isOpen = open && mobileViewport.matches;
    header?.classList.toggle("is-menu-open", isOpen);
    document.body.classList.toggle("is-menu-open", isOpen);
    document.documentElement.classList.toggle("is-menu-open", isOpen);
    menuToggle?.setAttribute("aria-expanded", String(isOpen));
    menuToggle?.setAttribute("aria-label", isOpen ? "Menu sluiten" : "Menu openen");
    if (nav) nav.inert = mobileViewport.matches && !isOpen;
    document.dispatchEvent(new CustomEvent("navigation:toggle", { detail: { isOpen } }));
    if (restoreFocus) menuToggle?.focus({ preventScroll: true });
  };

  setMenuState(false);
  mobileViewport.addEventListener("change", () => setMenuState(false));
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  menuToggle?.addEventListener("click", () => {
    setMenuState(!header?.classList.contains("is-menu-open"));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuState(false));
  });

  const sectionLinks = [...document.querySelectorAll('.site-header__nav a[href^="#"]')];
  const sectionTargets = sectionLinks
    .map((link) => document.querySelector(link.getAttribute("href") || ""))
    .filter(Boolean);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          return;
        }

        sectionLinks.forEach((link) => {
          const isCurrent = link.getAttribute("href") === `#${entry.target.id}`;
          link.classList.toggle("is-active", isCurrent);

          if (isCurrent) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      });
    },
    { rootMargin: "-36% 0px -52% 0px" },
  );

  sectionTargets.forEach((section) => observer.observe(section));

  window.addEventListener("keydown", (event) => {
    if (!header?.classList.contains("is-menu-open")) return;
    if (event.key === "Escape") {
      setMenuState(false, true);
    }
    if (event.key === "Tab") {
      const links = [...(nav?.querySelectorAll<HTMLAnchorElement>("a[href]") ?? [])];
      const first = links[0];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        menuToggle?.focus();
      } else if (!event.shiftKey && document.activeElement === menuToggle) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    width: 100%;
    padding: 1.15rem var(--content-gutter);
    color: var(--color-white);
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      padding 220ms ease;
  }

  /* Keep blur off the header: it would contain the fixed mobile drawer. */
  .site-header::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
    background: rgba(17, 19, 20, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .site-header::after {
    position: absolute;
    right: var(--content-gutter);
    bottom: 0;
    left: var(--content-gutter);
    height: 1px;
    content: "";
    background: rgba(255, 255, 255, 0.12);
  }

  .site-header.is-scrolled {
    padding-block: 0.8rem;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    width: clamp(9.4rem, 15.4vw, 13.5rem);
  }

  .site-header__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-header__nav {
    display: flex;
    justify-content: flex-end;
    gap: clamp(0.9rem, 2vw, 1.65rem);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .site-header__nav a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .site-header__mobile-cta,
  .site-header__toggle {
    display: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible,
  .site-header__nav a.is-active {
    color: var(--color-white);
  }

  .site-header__nav a.is-active {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.45em;
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    color: var(--color-charcoal);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    background: var(--color-accent);
    border: 1px solid rgba(255, 211, 67, 0.6);
    border-radius: 4px;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .site-header__cta:hover,
  .site-header__cta:focus-visible {
    background: var(--color-accent-soft);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .site-header {
      grid-template-columns: auto auto;
    }

    .site-header__nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      display: grid;
      align-content: start;
      justify-content: stretch;
      width: min(100%, 26rem);
      height: 100dvh;
      padding: 6.5rem 1.5rem max(2rem, env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: #0e1011;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: -2rem 0 4rem rgba(0, 0, 0, 0.28);
      transform: translateX(100%);
      visibility: hidden;
      pointer-events: none;
      transition: transform 260ms ease, visibility 0s linear 260ms;
    }

    .site-header.is-menu-open .site-header__nav {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    .site-header__nav a {
      padding: 1.05rem 0;
      font-size: 1.55rem;
      font-weight: 800;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .site-header__mobile-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      margin-top: 1rem;
      padding: 0 1rem;
      color: var(--color-charcoal) !important;
      font-size: 0.92rem !important;
      background: var(--color-accent);
      border: 0;
      border-radius: 4px;
    }

    .site-header__cta {
      display: none;
    }

    .site-header__toggle {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      min-height: 2.75rem;
      padding: 0 0.85rem;
      color: var(--color-white);
      justify-self: end;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 4px;
      cursor: pointer;
      transition:
        background-color 160ms ease,
        border-color 160ms ease;
    }

    .site-header__toggle:hover,
    .site-header__toggle:focus-visible {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(255, 255, 255, 0.36);
    }

    .site-header__toggle-label {
      font-size: 0.78rem;
      font-weight: 800;
    }

    .site-header__toggle-icon,
    .site-header__toggle-icon::before,
    .site-header__toggle-icon::after {
      display: block;
      width: 1rem;
      height: 1px;
      content: "";
      background: currentColor;
      transition:
        transform 180ms ease,
        opacity 180ms ease;
    }

    .site-header__toggle-icon::before {
      transform: translateY(-0.34rem);
    }

    .site-header__toggle-icon::after {
      transform: translateY(0.29rem);
    }

    .site-header.is-menu-open .site-header__toggle-icon {
      transform: rotate(45deg);
    }

    .site-header.is-menu-open .site-header__toggle-icon::before {
      opacity: 0;
    }

    .site-header.is-menu-open .site-header__toggle-icon::after {
      transform: translateY(-1px) rotate(-90deg);
    }
  }

  @media (max-width: 520px) {
    .site-header {
      gap: 0.75rem;
      padding-inline: var(--page-gutter);
    }

    .site-header::after {
      right: var(--page-gutter);
      left: var(--page-gutter);
    }

    .site-header__logo {
      width: 9.1rem;
    }

    .site-header__toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .site-header__toggle {
      width: 2.75rem;
      padding: 0;
    }
  }
</style>
