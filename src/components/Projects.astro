---
const projects = [
  {
    type: "Dakrenovatie",
    title: "Dakrenovatie met Velux",
    image: "images/03-project-dak-met-velux.png",
    width: 1448,
    height: 1086,
    modifier: "project--large",
  },
  {
    type: "Steigerwerken",
    title: "Renovatie met steigerwerken",
    image: "images/05-project-woning-met-steigers.png",
    width: 1448,
    height: 1086,
    modifier: "project--small",
  },
  {
    type: "Dakrenovatie",
    title: "Dakrenovatie met zonnepanelen",
    image: "images/06-project-witte-woning-zonnepanelen.png",
    width: 1187,
    height: 1326,
    modifier: "project--small",
  },
  {
    type: "Hellend dak",
    title: "Volledig afgewerkt hellend dak",
    image: "images/07-project-bakstenen-woning-afgewerkt-dak.png",
    width: 1448,
    height: 1086,
    modifier: "project--wide",
  },
  {
    type: "Constructie",
    title: "Nieuwe dakconstructie",
    image: "images/08-project-zolder-houtconstructie.png",
    width: 1444,
    height: 1089,
    modifier: "project--medium",
  },
  {
    type: "Onderdak",
    title: "Onderdak en lattenwerk",
    image: "images/09-project-blauw-dak-lattenraster.png",
    width: 1448,
    height: 1086,
    modifier: "project--medium",
  },
];

const base = import.meta.env.BASE_URL;
---

<section class="projects" id="realisaties" aria-labelledby="projects-title">
  <div class="projects__intro" data-projects-reveal>
    <p class="projects__eyebrow">REALISATIES</p>
    <h2 id="projects-title">Vakwerk dat voor zich spreekt.</h2>
    <p>Een selectie van recente dakwerken, renovaties en afwerkingen.</p>
  </div>

  <div class="projects__grid">
    {
      projects.map((project) => (
        <a class={`project ${project.modifier}`} href="#contact" data-projects-reveal>
          <img
            src={`${base}${project.image}`}
            alt={project.title}
            loading="lazy"
            width={project.width}
            height={project.height}
          />
          <div class="project__overlay" aria-hidden="true"></div>
          <div class="project__content">
            <p>{project.type}</p>
            <h3>{project.title}</h3>
          </div>
        </a>
      ))
    }
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    gsap.from("[data-projects-reveal]", {
      autoAlpha: 0,
      y: 24,
      duration: 0.85,
      ease: "power3.out",
      stagger: 0.1,
      immediateRender: false,
      scrollTrigger: {
        trigger: ".projects",
        start: "top 72%",
        once: true,
      },
    });
  }
</script>

<style>
  .projects {
    padding: var(--section-space) var(--content-gutter);
    color: var(--color-white);
    background: #111314;
  }

  .projects__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.25rem);
    align-items: end;
    margin-bottom: clamp(3.25rem, 6vw, 5.5rem);
  }

  .projects__eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 clamp(0.55rem, 1.4vw, 1rem);
    color: var(--color-accent);
    font-size: var(--label-size);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .projects__intro h2 {
    grid-column: 1 / span 6;
    max-width: 11.5ch;
    margin: 0;
    font-size: var(--heading-section);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .projects__intro p:not(.projects__eyebrow) {
    grid-column: 8 / span 4;
    max-width: 29rem;
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.65;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(14.25rem, 22vw, 20.5rem);
    gap: clamp(0.8rem, 1.6vw, 1.25rem);
  }

  .project {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    color: var(--color-white);
    text-decoration: none;
    background: var(--color-charcoal-soft);
    cursor: pointer;
    isolation: isolate;
  }

  .project--large {
    grid-column: 1 / span 7;
    grid-row: span 2;
  }

  .project--small {
    grid-column: 8 / span 5;
  }

  .project--wide {
    grid-column: 1 / -1;
    grid-row: span 2;
  }

  .project--medium {
    grid-column: span 6;
    grid-row: span 2;
  }

  .project img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 700ms ease;
  }

  .project__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(17, 19, 20, 0.04) 22%, rgba(17, 19, 20, 0.34) 62%, rgba(17, 19, 20, 0.82) 100%),
      linear-gradient(90deg, rgba(17, 19, 20, 0.22) 0%, rgba(17, 19, 20, 0) 58%);
    transition: background-color 260ms ease;
  }

  .project__content {
    position: absolute;
    right: clamp(1.25rem, 2.2vw, 2rem);
    bottom: clamp(1.25rem, 2.2vw, 2rem);
    left: clamp(1.25rem, 2.2vw, 2rem);
    transition: transform 260ms ease;
  }

  .project__content p {
    margin: 0 0 0.55rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project__content h3 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(1.55rem, 2.8vw, 3rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .project--small .project__content h3 {
    font-size: clamp(1.3rem, 2vw, 2rem);
  }

  .project:hover img,
  .project:focus-visible img {
    transform: scale(1.03);
  }

  .project:hover .project__overlay,
  .project:focus-visible .project__overlay {
    background-color: rgba(17, 19, 20, 0.16);
  }

  .project:hover .project__content,
  .project:focus-visible .project__content {
    transform: translateY(-8px);
  }

  .project:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 980px) {
    .projects__intro {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .projects__intro h2 {
      grid-column: 1 / span 5;
    }

    .projects__intro p:not(.projects__eyebrow) {
      grid-column: 6 / span 3;
    }

    .projects__grid {
      grid-auto-rows: auto;
    }

    .project--large,
    .project--small,
    .project--wide,
    .project--medium {
      grid-column: span 6;
      grid-row: auto;
      min-height: clamp(20rem, 44vw, 28rem);
    }

    .project--large,
    .project--wide {
      grid-column: span 12;
    }
  }

  @media (max-width: 720px) {
    .projects__intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .projects__eyebrow,
    .projects__intro h2 {
      grid-column: auto;
      max-width: none;
    }

    .projects__intro p:not(.projects__eyebrow) {
      grid-column: auto;
      margin-bottom: 0;
    }

    .projects__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 0.9rem;
    }

    .project--large,
    .project--small,
    .project--wide,
    .project--medium {
      grid-column: auto;
      grid-row: auto;
      min-height: 22rem;
    }
  }
</style>
