---
const services = [
  {
    title: "Dakrenovatie",
    text: "Renovatie van bestaande daken met aandacht voor duurzaamheid en correcte afwerking.",
  },
  {
    title: "Velux",
    text: "Plaatsing van Velux dakramen voor meer licht en comfort.",
  },
  {
    title: "Zinkwerk",
    text: "Strakke en duurzame afwerking van goten, dakranden en aansluitingen.",
  },
  {
    title: "Rustieke dakbedekking",
    text: "Traditionele uitstraling gecombineerd met moderne kwaliteit.",
  },
];
---

<section class="services" id="diensten" aria-labelledby="services-title">
  <div class="services__intro" data-services-reveal>
    <p class="services__eyebrow">Diensten</p>
    <h2 id="services-title">Onze diensten</h2>
    <p>Van renovatie tot afwerking. Eén vakman voor uw volledige dak.</p>
  </div>

  <div class="services__grid">
    {
      services.map((service, index) => (
        <article class="service" data-services-reveal>
          <span class="service__number">{String(index + 1).padStart(2, "0")}</span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))
    }
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    gsap.from("[data-services-reveal]", {
      autoAlpha: 0,
      y: 24,
      duration: 0.8,
      ease: "power3.out",
      stagger: 0.12,
      immediateRender: false,
      scrollTrigger: {
        trigger: ".services",
        start: "top 72%",
        once: true,
      },
    });
  }
</script>

<style>
  .services {
    position: relative;
    padding: var(--section-space) var(--content-gutter);
    overflow: hidden;
    color: var(--color-white);
    background:
      linear-gradient(180deg, var(--color-charcoal) 0%, #16191a 100%),
      var(--color-charcoal);
  }

  .services::before {
    position: absolute;
    inset: 0 var(--content-gutter) auto;
    height: 1px;
    content: "";
    background: rgba(255, 255, 255, 0.12);
  }

  .services__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 29rem);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  .services__eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 -0.45rem;
    color: var(--color-accent);
    font-size: var(--label-size);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .services__intro h2 {
    max-width: 10ch;
    margin: 0;
    font-size: var(--heading-section);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .services__intro p:not(.services__eyebrow) {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.65;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }

  .service {
    position: relative;
    min-height: clamp(19rem, 28vw, 25rem);
    padding: clamp(1.3rem, 2.3vw, 2rem);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.015);
    border-right: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    transition:
      background-color 220ms ease,
      transform 220ms ease;
  }

  .service::before {
    position: absolute;
    inset: auto 1.4rem 1.4rem auto;
    width: clamp(3rem, 6vw, 5rem);
    height: 1px;
    content: "";
    background: var(--color-accent);
    opacity: 0.5;
    transform-origin: right;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  .service:hover {
    background: rgba(255, 255, 255, 0.045);
    transform: translateY(-6px);
  }

  .service:hover::before {
    opacity: 0.9;
    transform: scaleX(1.45);
  }

  .service__number {
    display: block;
    margin-bottom: clamp(4.5rem, 9vw, 8rem);
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .service h3 {
    max-width: 9ch;
    margin: 0;
    font-size: clamp(1.65rem, 2.6vw, 2.7rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .service p {
    max-width: 21rem;
    margin: 1.15rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  @media (max-width: 1040px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .services__intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .services__intro h2 {
      max-width: none;
    }

    .services__grid {
      grid-template-columns: 1fr;
    }

    .service {
      min-height: 17rem;
    }

    .service__number {
      margin-bottom: 3.25rem;
    }
  }
</style>
